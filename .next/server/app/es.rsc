4:["$","$L14",null,{"formats":"$undefined","locale":"es","messages":{"navigation":{"home":"Inicio","about":"Sobre Mí","experience":"Experiencia","services":"Servicios","projects":"Proyectos","contact":"Contacto"},"services":{"title":"Mis Servicios","webDevelopment":{"title":"Desarrollo Web","description":"Creación de sitios web modernos y responsivos utilizando las últimas tecnologías."},"mobileDevelopment":{"title":"Desarrollo Móvil","description":"Desarrollo de aplicaciones móviles nativas y multiplataforma."},"uiDesign":{"title":"Diseño UI/UX","description":"Diseño de interfaces de usuario intuitivas y atractivas."},"cloudDevOps":{"title":"Infraestructura Cloud & DevOps","description":"Despliegue y administración de infraestructura (AWS, Docker, S3, Route53, Balanceadores, CI/CD)."},"customApps":"Desarrollo de aplicaciones 100% personalizadas (web, escritorio, móvil, etc.)","documentation":"Entrega de documentación completa: especificación de requerimientos, cotizaciones, facturas, contratos y diagramas UML","projectLifecycle":"Gestión de todo el ciclo de vida del proyecto de software: análisis, diseño, desarrollo, pruebas, despliegue y mantenimiento","maintenance":"Mantenimiento y soporte para sistemas existentes","consulting":"Asesoría y acompañamiento en la digitalización de procesos","integration":"Integración de sistemas y automatización de procesos empresariales","security":"Implementación de buenas prácticas de seguridad y respaldo de información","training":"Capacitación y documentación para usuarios finales y administradores","personalizedSupport":"Atención personalizada y comunicación constante durante todo el proyecto","moreTitle":"¿Qué más ofrezco?"},"common":{"language":"Idioma","english":"Inglés","spanish":"Español"},"experience":{"title":"Experiencia Profesional","capitalPlus":{"role":"Software Engineer / Automation Engineer","company":"Capital Plus Bienes Raíces S.A. de C.V.","period":"Agosto 2025 - Presente","responsibilities":{"1":"Diseñé e implementé una plataforma de automatización modular basada en MVC en Python, integrando CRM, inventario, visualización de ventas y reportes vía APIs REST y webhooks controlados por eventos, con arquitectura preparada para cargas de alta concurrencia.","2":"Construí y mantuve más de 25 automatizaciones backend para leads, inventario, precios, comisiones, análisis y reportes usando Deluge, APIs REST y webhooks, implementando aislamiento de fallas, registro y monitoreo para prevenir fallas en cascada entre sistemas.","3":"Desarrollé un algoritmo de distribución de leads basado en reglas en Zoho, implementando asignación tipo round-robin con restricciones de disponibilidad y geográficas, reduciendo leads no asignados de 40–70% a 0% manteniendo una distribución de carga equilibrada.","4":"Diseñé un sistema de inventario y precios basado en eventos con gestión de estado y bloqueo de reservas, priorizando el acceso por orden de llegada y forzando una ventana de retención de 3 días antes de la liberación automática, previniendo duplicidad de reservas.","5":"Integré VoIP Aircall usando webhooks basados en eventos (inicio de llamada), implementando enrutamiento dinámico basado en la propiedad del prospecto para asignar llamadas automáticamente al agente de ventas correcto, con persistencia y manejo de fallas.","6":"Construí pipelines de reportes automatizados en Python, agregando datos de CRM y operativos para generar reportes KPI programados en formato PDF para la toma de decisiones ejecutivas semanal y mensual.","7":"Desarrollé pipelines de web scraping usando Playwright para extraer datos de sitios web estáticos y pesados en JavaScript bajo demanda, realizando limpieza y normalización de datos usando expresiones regulares para análisis posterior.","8":"Diseñé un prototipo interno de agente de IA usando Generación Aumentada por Recuperación (RAG), indexando documentos legales y técnicos PDF en Pinecone para permitir búsqueda semántica con embeddings y acceso interno controlado.","9":"Reduje los tiempos de respuesta al cliente de 1–3 horas a menos de 30 minutos automatizando la asignación de llamadas, enrutamiento de leads y medición de SLA a través de eventos VoIP integrados y métricas operativas en tiempo real."}}},"education":{"title":"Educación","degree":"Ingeniería en Sistemas Computacionales","institution":"Instituto Tecnológico Superior de Atlixco","period":"2021-2026"},"languages":{"title":"Idiomas","spanish":"Español: Nativo","english":"Inglés: B2"},"projects":{"title":"Mis Proyectos","viewGithub":"Ver en GitHub","viewDemo":"Visitar Sitio","ebenezer":{"description":"Sistema de Gestión de Laboratorios Clínicos: Citas, servicio, soporte multi-sucursal y panel de administración.","longDescription":"Sistema completo de gestión para laboratorios clínicos que permite modificar imágenes y texto de toda la página, asignar horarios para citas médicas, gestionar citas de pacientes, subir servicios de laboratorio y dar de alta sucursales. Incluye panel administrativo completo para la gestión integral del laboratorio.","features":{"1":"Gestión de citas médicas y servicios por sucursal","2":"Editor de contenido para modificar imágenes y texto","3":"Sistema de gestión de horarios y disponibilidad","4":"Administración de servicios de laboratorio y sucursales"}},"sitdr":{"description":"Plataforma de Monitoreo Académico: Seguimiento de estudiantes, asignación de tutores y reportes académicos.","longDescription":"Plataforma universitaria para monitorear y gestionar el progreso académico de los estudiantes. Incluye herramientas para el seguimiento de tutores y alumnos, reportes académicos detallados, generación de planes personalizados y analíticas avanzadas. El sistema mejoró la eficiencia de los tutores en un 30% y el compromiso estudiantil en un 25%, facilitando intervenciones académicas basadas en datos y reportes personalizados.","features":{"1":"Seguimiento detallado de tutores y estudiantes","2":"Generación de reportes y planes personalizados","3":"Analíticas y reportes para intervenciones académicas","4":"Mejora en la eficiencia y el compromiso estudiantil"}},"danjvic":{"description":"Sitio web para empresa de puertas de garaje.","longDescription":"Plataforma web para una empresa especializada en la venta e instalación de puertas de garaje. Permite gestionar el contenido del sitio, servicios ofrecidos y mantener un control detallado de clientes con sus respectivas garantías.","features":{"1":"Editor de contenido para modificar imágenes y texto","2":"Sistema de contacto para consultas de clientes","3":"Gestión y alta de servicios ofrecidos","4":"Control de clientes y seguimiento de garantías"}},"srg":{"description":"Sistema de Gestión de Gimnasios (SRG Vortex): Membresías, asistencia, clases y ventas.","longDescription":"Sistema integral para automatizar la gestión de membresías, asistencias, clases, ventas y control de caja en un gimnasio. El sistema reduce tareas administrativas, mejora la experiencia del usuario y optimiza la operación diaria. Beneficios: automatización de registros, flexibilidad para membresías y clases, control financiero detallado, eficiencia operativa y reportes en tiempo real. Logra una reducción del 50% en la carga administrativa y una experiencia mejorada para los miembros con funciones como check-in automático y programación de clases.","features":{"1":"Gestión automatizada de membresías y asistencias","2":"Panel de control para administración y reportes","3":"Notificaciones y programación en tiempo real","4":"Reducción de tareas administrativas y errores"}},"webScraping":{"description":"Scraper de Inteligencia de Mercado: Extracción y normalización automatizada de datos inmobiliarios.","longDescription":"Colección de scripts de web scraping desarrollados en Python utilizando librerías como BeautifulSoup, Selenium y Scrapy. Estos scripts permiten extraer información de sitios web de manera automatizada, procesar datos estructurados y almacenarlos en diferentes formatos. Incluyen manejo de errores, respeto a los tiempos de espera entre solicitudes y soporte para sitios web dinámicos con JavaScript.","features":{"1":"Extracción automatizada de datos de sitios web","2":"Soporte para sitios web estáticos y dinámicos","3":"Procesamiento y almacenamiento de datos estructurados","4":"Manejo de errores y respeto a políticas de robots.txt"}},"aiReportGenerator":{"description":"Plataforma de Analítica Automatizada: Pipelines de datos para KPIs y dashboards ejecutivos.","longDescription":"Sistema de generación automática de reportes utilizando inteligencia artificial para analizar datos, identificar patrones y crear documentos profesionales. El sistema procesa información de múltiples fuentes, genera insights automáticos y produce reportes personalizados con visualizaciones y análisis detallados. Utiliza modelos de lenguaje para resumir información y crear narrativas coherentes basadas en los datos analizados.","features":{"1":"Generación automática de reportes con IA","2":"Análisis de datos y detección de patrones","3":"Visualizaciones y gráficos personalizados","4":"Resúmenes y narrativas generadas automáticamente"}},"grupoSedico":{"description":"Sitio Web Corporativo - Grupo Sedico México: Sitio web corporativo responsivo enfocado en conversión.","longDescription":"Sitio web moderno y responsivo desarrollado para Grupo Sedico México, empresa líder en la fabricación de envases plásticos PET. La plataforma presenta el catálogo de productos, servicios de fabricación personalizada, información corporativa y sistema de contacto. Incluye diseño optimizado para conversión, secciones de productos destacados, información sobre procesos de fabricación y formularios de contacto integrados. El sitio refleja la identidad de marca de la empresa y facilita la comunicación con clientes potenciales.","features":{"1":"Catálogo de productos con información detallada","2":"Diseño responsivo y optimizado para móviles","3":"Sistema de contacto y formularios integrados","4":"Presentación de servicios y procesos de fabricación"}},"sanMarco":{"description":"Sitio web para restaurante italiano San Marco Ristorante.","longDescription":"Plataforma web elegante para San Marco Ristorante, destacando su auténtica cocina italiana. El sitio incluye menú digital interactivo, sistema de reservaciones en línea, galería de platillos, información sobre eventos especiales y sección de contacto. Diseño sofisticado que refleja la experiencia gastronómica del restaurante con fotografía profesional de alimentos y navegación intuitiva.","features":{"1":"Menú digital interactivo con fotografías profesionales","2":"Sistema de reservaciones en línea","3":"Galería de platillos y eventos especiales","4":"Diseño elegante y responsivo"}},"puntoTierra":{"description":"Sitio web inmobiliario para Punto Tierra - Proyectos sustentables.","longDescription":"Plataforma inmobiliaria moderna para Punto Tierra, especializada en proyectos de bienes raíces sustentables y ecológicos. El sitio presenta catálogo de propiedades disponibles, información detallada de cada proyecto, calculadora de financiamiento, tours virtuales y sistema de contacto. Diseño minimalista con tonos tierra que reflejan el compromiso con la sustentabilidad y la naturaleza.","features":{"1":"Catálogo de propiedades sustentables","2":"Tours virtuales y galerías de imágenes","3":"Calculadora de financiamiento integrada","4":"Diseño eco-friendly con identidad de marca"}},"capitalPlus":{"description":"Plataforma de Gestión Inmobiliaria: Sistema backend para CRM, control de inventario y automatización.","longDescription":"Sistema integral de gestión empresarial para Capital Plus que incluye agente de IA para análisis automatizado, visualización avanzada de métricas de rendimiento y sistema de seguimiento de comisiones. La plataforma ofrece dashboards personalizables, reportes automatizados con inteligencia artificial, análisis predictivo de ventas y gestión completa del equipo comercial. Incluye notificaciones en tiempo real y herramientas de toma de decisiones basadas en datos.","features":{"1":"Agente de IA para análisis automatizado y predictivo","2":"Dashboard de métricas y KPIs en tiempo real","3":"Sistema de seguimiento y cálculo de comisiones","4":"Reportes automatizados y visualización de datos"}}},"about":{"title":"Sobre Mí","description":"Ingeniero de Backend y Automatización con experiencia práctica diseñando y operando sistemas backend de alta concurrencia, automatizaciones críticas para el negocio y plataformas impulsadas por datos. Sólida experiencia en Python, Django, APIs REST e integraciones impulsadas por eventos. Capacidad demostrada para reducir cuellos de botella operativos, mejorar métricas de SLA y generar impacto comercial medible a través de arquitectura limpia y automatización a nivel de sistema."},"contact":{"title":"Contacto","formTitle":"Contáctame","name":"Nombre","email":"Correo electrónico","message":"Mensaje","send":"Enviar","sending":"Enviando...","success":"¡Mensaje enviado con éxito!"},"hero":{"title":"Rodrigo Navarro","subtitle":"Ingeniero de Software | Backend, Automatización y Sistemas Escalables","projects":"Ver Proyectos","contact":"Contactar"}},"now":"$undefined","timeZone":"America/Mexico_City","children":["$","$L2",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]}]
