4:["$","$L14",null,{"formats":"$undefined","locale":"en","messages":{"navigation":{"home":"Home","about":"About","experience":"Experience","services":"Services","projects":"Projects","contact":"Contact"},"services":{"title":"My Services","webDevelopment":{"title":"Web Development","description":"Creation of modern and responsive websites using the latest technologies."},"mobileDevelopment":{"title":"Mobile Development","description":"Development of native and cross-platform mobile applications."},"uiDesign":{"title":"UI/UX Design","description":"Design of intuitive and attractive user interfaces."},"cloudDevOps":{"title":"Cloud & DevOps","description":"Deployment and management of infrastructure (AWS, Docker, S3, Route53, Load Balancers, CI/CD)."},"customApps":"Development of 100% customized applications (web, desktop, mobile, etc.)","documentation":"Delivery of complete documentation: requirements specification, quotes, invoices, contracts, and UML diagrams","projectLifecycle":"Management of the entire software project lifecycle: analysis, design, development, testing, deployment, and maintenance","maintenance":"Maintenance and support for existing systems","consulting":"Consulting and support in process digitalization","integration":"System integration and business process automation","security":"Implementation of best security practices and data backup","training":"Training and documentation for end users and administrators","personalizedSupport":"Personalized attention and constant communication throughout the project","moreTitle":"What else do I offer?"},"common":{"language":"Language","english":"English","spanish":"Spanish"},"experience":{"title":"Professional Experience","capitalPlus":{"role":"Software Engineer / Automation Engineer","company":"Capital Plus Bienes Raíces S.A. de C.V.","period":"August 2025 - Present","responsibilities":{"1":"Designed and implemented a modular MVC-based automation platform in Python, integrating CRM, inventory, sales pipelines, and reporting via REST APIs and event-driven webhooks, with architecture prepared for high-concurrency workloads.","2":"Built and maintained 25+ backend automations for leads, inventory, pricing, commissions, analytics, and reporting using Deluge, REST APIs, and webhooks, implementing fault isolation, logging, and monitoring to prevent cascading failures across systems.","3":"Developed a rule-based lead distribution algorithm in Zoho, implementing pool-style round-robin assignment with availability and geographic constraints, reducing unassigned leads from 40–70% to 0% while maintaining balanced workload distribution.","4":"Engineered an event-driven inventory and pricing system with state management and reservation locking, prioritizing first-come access and enforcing a 3-day hold window before automatic release, preventing double-booking across concurrent sales workflows.","5":"Integrated Aircall VoIP using event-driven webhooks (call started), implementing dynamic call routing based on prospect ownership to automatically assign calls to the correct sales agent, with persistence and failure handling.","6":"Built automated reporting pipelines in Python, aggregating CRM and operational data to generate scheduled KPI reports in PDF format for weekly and monthly executive decision-making.","7":"Developed web scraping pipelines using Playwright to extract data from static and JavaScript-heavy websites on demand, performing data cleaning and normalization using regular expressions for downstream analysis.","8":"Designed an internal prototype AI agent using Retrieval-Augmented Generation (RAG), indexing legal and technical PDF documents in Pinecone to enable semantic search with embeddings and controlled internal access.","9":"Reduced customer response times from 1–3 hours to under 30 minutes by automating call assignment, lead routing, and SLA measurement through integrated VoIP events and real-time operational metrics."}}},"education":{"title":"Education","degree":"B.S. in Computer Systems Engineering","institution":"Instituto Tecnológico Superior de Atlixco","period":"2021-2026"},"languages":{"title":"Languages","spanish":"Spanish: Native","english":"English: B2"},"projects":{"title":"My Projects","viewGithub":"View on GitHub","viewDemo":"Visit Site","ebenezer":{"description":"Clinical Laboratory Management System: Appointment scheduling, service management, multi-branch support, and admin panel.","longDescription":"Complete management system for clinical laboratories that allows modifying images and text throughout the page, scheduling medical appointments, managing patient appointments, uploading laboratory services, and registering branches. Includes a complete administrative panel for comprehensive laboratory management.","features":{"1":"Medical appointment and service management by branch","2":"Content editor for modifying images and text","3":"Schedule and availability management system","4":"Laboratory services and branch administration"}},"sitdr":{"description":"Academic Monitoring Platform: Student tracking, tutor assignments, and academic reporting.","longDescription":"University tutoring platform to monitor and manage students' academic progress. Includes tools for tracking tutors and students, detailed academic reports, personalized tutoring plans, and advanced analytics. The system improved tutor efficiency by 30% and student engagement by 25%, enabling data-driven academic interventions and personalized reporting.","features":{"1":"Detailed tracking of tutors and students","2":"Generation of reports and personalized plans","3":"Analytics and reporting for academic interventions","4":"Improved efficiency and student engagement"}},"danjvic":{"description":"Website for garage door company.","longDescription":"Web platform for a company specialized in the sale and installation of garage doors. Allows managing site content, offered services, and maintaining detailed customer control with their respective warranties.","features":{"1":"Content editor for modifying images and text","2":"Contact system for customer inquiries","3":"Management and registration of offered services","4":"Customer control and warranty tracking"}},"srg":{"description":"Gym Management System (SRG Vortex): Memberships, attendance tracking, class scheduling, and sales management.","longDescription":"Comprehensive system to automate the management of memberships, check-ins, classes, sales, and cash register control in a gym. The system reduces administrative workload, improves user experience, and optimizes daily operations. Benefits: automation of records, flexibility for memberships and classes, detailed financial control, operational efficiency, and real-time reporting. Achieves a 50% reduction in administrative tasks and enhanced member experience with features like automated check-ins and real-time class scheduling.","features":{"1":"Automated management of memberships and check-ins","2":"Admin dashboard and reporting tools","3":"Real-time notifications and scheduling","4":"Reduced administrative workload and errors"}},"webScraping":{"description":"Market Intelligence Scraper: Automated real estate data extraction and normalization.","longDescription":"Collection of web scraping scripts developed in Python using libraries like BeautifulSoup, Selenium, and Scrapy. These scripts allow automated extraction of information from websites, processing structured data, and storing it in different formats. They include error handling, respect for wait times between requests, and support for dynamic JavaScript websites.","features":{"1":"Automated data extraction from websites","2":"Support for static and dynamic websites","3":"Processing and storage of structured data","4":"Error handling and respect for robots.txt policies"}},"aiReportGenerator":{"description":"Automated Analytics Platform: Data pipelines for KPI generation, validation, and executive dashboards.","longDescription":"Automatic report generation system using artificial intelligence to analyze data, identify patterns, and create professional documents. The system processes information from multiple sources, generates automatic insights, and produces personalized reports with visualizations and detailed analysis. Uses language models to summarize information and create coherent narratives based on analyzed data.","features":{"1":"Automatic report generation with AI","2":"Data analysis and pattern detection","3":"Custom visualizations and charts","4":"Automatically generated summaries and narratives"}},"grupoSedico":{"description":"Corporate Website - Grupo Sedico México: Conversion-focused responsive corporate website.","longDescription":"Modern and responsive website developed for Grupo Sedico México, a leading manufacturer of PET plastic containers. The platform features product catalog, custom manufacturing services, corporate information, and contact system. Includes conversion-optimized design, featured products sections, information about manufacturing processes, and integrated contact forms. The site reflects the company's brand identity and facilitates communication with potential customers.","features":{"1":"Product catalog with detailed information","2":"Responsive design optimized for mobile","3":"Contact system and integrated forms","4":"Presentation of services and manufacturing processes"}},"sanMarco":{"description":"Website for Italian restaurant San Marco Ristorante.","longDescription":"Elegant web platform for San Marco Ristorante, showcasing authentic Italian cuisine. The site includes an interactive digital menu, online reservation system, dish gallery, special events information, and contact section. Sophisticated design that reflects the restaurant's gastronomic experience with professional food photography and intuitive navigation.","features":{"1":"Interactive digital menu with professional photography","2":"Online reservation system","3":"Dish gallery and special events","4":"Elegant and responsive design"}},"puntoTierra":{"description":"Real estate website for Punto Tierra - Sustainable projects.","longDescription":"Modern real estate platform for Punto Tierra, specializing in sustainable and eco-friendly real estate projects. The site features available property catalog, detailed project information, financing calculator, virtual tours, and contact system. Minimalist design with earth tones reflecting commitment to sustainability and nature.","features":{"1":"Sustainable property catalog","2":"Virtual tours and image galleries","3":"Integrated financing calculator","4":"Eco-friendly design with brand identity"}},"capitalPlus":{"description":"Real Estate Management Platform: Backend system for CRM, inventory control, automation logic, and executive reporting.","longDescription":"Comprehensive business management system for Capital Plus featuring AI agent for automated analysis, advanced performance metrics visualization, and commission tracking system. The platform offers customizable dashboards, AI-powered automated reports, predictive sales analytics, and complete sales team management. Includes real-time notifications and data-driven decision-making tools.","features":{"1":"AI agent for automated and predictive analysis","2":"Real-time metrics and KPI dashboard","3":"Commission tracking and calculation system","4":"Automated reports and data visualization"}}},"about":{"title":"About Me","description":"Backend and Automation Engineer with hands-on experience designing and operating high-concurrency backend systems, business-critical automations, and data-driven platforms. Strong background in Python, Django, REST APIs, and event-driven integrations. Proven ability to reduce operational bottlenecks, improve SLA performance, and deliver measurable business impact through clean architecture and system-level automation."},"contact":{"title":"Contact","formTitle":"Contact Me","name":"Name","email":"Email","message":"Message","send":"Send","sending":"Sending...","success":"Message sent successfully!"},"hero":{"title":"Rodrigo Navarro","subtitle":"Software Engineer | Backend, Automation & Scalable Systems","projects":"View Projects","contact":"Contact"}},"now":"$undefined","timeZone":"America/Mexico_City","children":["$","$L2",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L3",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]}]
